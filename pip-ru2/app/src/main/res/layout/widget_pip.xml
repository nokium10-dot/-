<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/pip_face"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Пип"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_feed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Покормить"
            android:gravity="center"
            android:text="🍎"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Играть"
            android:gravity="center"
            android:text="🎾"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_pet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Погладить"
            android:gravity="center"
            android:text="🤚"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Голос"
            android:gravity="center"
            android:text="🎙"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
