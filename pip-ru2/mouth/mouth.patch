+    if (mood == PIP_RAGE || mood == PIP_FURIOUS || mood == PIP_ANGRY)
+        h += (mood == PIP_RAGE ? 9 : 5) * sinf(s.t * (mood == PIP_RAGE ? 22 : 9)), curve -= 3 * sinf(s.t * 6); /* growling */
+    if (mood == PIP_SWEARING) h += 10 * fabsf(sinf(s.t * 15)), wave += 4 * sinf(s.t * 20);
+    if (mood == PIP_AFRAID || mood == PIP_NERVOUS) wave += 3 * sinf(s.t * 30);
+    if (mood == PIP_STONED || mood == PIP_COMFY || mood == PIP_CONTENT) curve += 2 * sinf(s.t * 1.1f);
+    if (mood == PIP_PUZZLED || mood == PIP_CURIOUS) tilt += 4 * sinf(s.t * 1.9f);
+    if (mood == PIP_LOVE || mood == PIP_HAPPY || mood == PIP_CHEEKY) curve += 2.5f * sinf(s.t * 3.0f);
+    if (mood == PIP_NO) tilt += 5 * sinf(s.t * 13);
