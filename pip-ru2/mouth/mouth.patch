+/* Where the mouth is and how it moves: it sits under the middle of the eyes, turns with the head, and every mood
+   adds its own life to the shape (breathing, a quiver, dizzy waves, chatter while he speaks). */
+static void mouth_fill(int mood, float hy, float hr, float sq, const mood_def_t *m)
+{
+    mouth_t *o = &s.face.mouth;
+    float v[MOUTH_N];
+    for (int j = 0; j < MOUTH_N; j++) v[j] = s.mouth[j].x;
